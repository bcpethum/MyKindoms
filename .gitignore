# ═══════════════════════════════════════
#   MyKingdoms — MERN Project .gitignore
# ═══════════════════════════════════════

# ─── Dependencies ───────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ─── Environment Variables ──────────────
# NEVER commit .env files — they contain secrets
.env
.env.local
.env.development
.env.production
.env.test
client/.env
client/.env.local
client/.env.development
client/.env.production
server/.env
server/.env.local
server/.env.production

# ─── Build Output ───────────────────────
dist/
build/
client/dist/
client/build/
server/dist/

# ─── Vite / React ───────────────────────
client/.vite/
*.local

# ─── Logs ───────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / Temp Files ───────────────
*.pid
*.seed
*.pid.lock
pids/
lib-cov/
coverage/
.nyc_output/
.grunt/
bower_components/
.lock-wscript

# ─── Cache ──────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ─── OS Generated ───────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor / IDE ───────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── Package Managers ───────────────────
# Keep package-lock.json and yarn.lock committed
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ─── TypeScript ─────────────────────────
*.tsbuildinfo

# ─── Testing ────────────────────────────
coverage/
.jest/

# ─── Cloudinary / Uploads ───────────────
uploads/
public/uploads/

# ─── Misc ───────────────────────────────
*.zip
*.tar.gz
.history/
